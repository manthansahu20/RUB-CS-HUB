stack = []

# Push
stack.append(10)
stack.append(20)
stack.append(30)

print("Stack:", stack)

# Pop
print("Popped Element:", stack.pop())

print("Stack After Pop:", stack)

queue = []

# Enqueue
queue.append(10)
queue.append(20)
queue.append(30)

print("Queue:", queue)

# Dequeue
print("Deleted Element:", queue.pop(0))

print("Queue After Delete:", queue)
